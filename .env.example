# University Student-Support Case Agent — environment template.
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# Primary provider, per the Model Selection Note (Section 2.4).
# Options: gemini | openai | ollama
LLM_PROVIDER=gemini

# Prompt specification loaded from prompts/ (v1.0, v2.0, v3.0, v4.0).
# Defaults to v4.0 (Week 5 Plan/Decide prompt for the bounded agent loop).
#PROMPT_VERSION=v4.0

# --- Gemini 2.5 Flash (primary) — Google AI Studio API key ---
GEMINI_API_KEY=your_google_ai_studio_key_here
#GEMINI_MODEL=gemini-3.6-flash
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- GPT-4o mini (paid backup) ---
#OPENAI_API_KEY=your_openai_api_key_here
#OPENAI_MODEL=gpt-4o-mini

# --- Llama 3.1 8B via Ollama (local, optional) ---
#OLLAMA_MODEL=llama3.1:8b
#OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Week 3 RAG (ChromaDB index) ---
# Corpus: plain-text extractions under knowledge/text/*.txt, produced from the
# PDFs/HTML in knowledge/raw by src/fetch_corpus.py; titles and real/synthetic
# provenance come from knowledge/corpus.json.
#RAG_CORPUS_DIR=knowledge/text
# Embeddings provider: gemini (default, uses GEMINI_API_KEY) | onnx (local fallback)
#RAG_EMBEDDING_PROVIDER=gemini
#GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Pacing (seconds) between embedding batch requests. The free Gemini tier
# allows ~5 batchEmbedContents calls/minute, so un-paced runs trip HTTP 429
# and burn retry attempts. Set to 0 for a paid key or the local ONNX embedder.
#RAG_EMBED_PACE=13
# Chunks per retrieval call attached to the prompt as RETRIEVED EVIDENCE.
#RAG_TOP_K=3
# Chunking limits: max characters per chunk and overlap carried across chunks.
#RAG_CHUNK_SIZE=800
#RAG_CHUNK_OVERLAP=80

# --- Week 5 bounded agent loop (src/orchestrator.py) ---
# Three approved tools the model may choose between inside one turn:
# get_case_status, create_support_ticket (Week 4) and retrieve_evidence.
# Max Sense/Plan/Act/Observe iterations per student turn. If the model keeps
# asking for tools beyond this, the loop stops and closes the turn with a
# human-readable "I could not fully resolve this" message instead of
# fabricating an answer.
#MAX_TOOL_ROUNDS=5
# How many hard tool failures (a timeout, a retrieval error -- not a normal
# "not found"/"invalid" business result) end a run. 2 = the model may
# re-plan once after the first failure, then the loop stops safely.
#MAX_TOOL_ERROR_STRIKES=2
# Optional JSON file for the mock case/ticket sandbox (src/tools/mock_store.py).
# Empty (default) = in-memory only, reset on every process start.
#TOOLS_STORE_FILE=knowledge/tool_store.json