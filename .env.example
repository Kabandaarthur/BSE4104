# University Student-Support Case Agent — environment template.
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# Primary provider, per the Model Selection Note (Section 2.4).
# Options: gemini | openai | ollama
LLM_PROVIDER=gemini

# --- Gemini 2.5 Flash (primary) — Google AI Studio API key ---
GEMINI_API_KEY=your_google_ai_studio_key_here
#GEMINI_MODEL=gemini-3.6-flash
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- GPT-4o mini (paid backup) ---
#OPENAI_API_KEY=your_openai_api_key_here
#OPENAI_MODEL=gpt-4o-mini

# --- Llama 3.1 8B via Ollama (local, optional) ---
#OLLAMA_MODEL=llama3.1:8b
#OLLAMA_BASE_URL=http://localhost:11434/v1